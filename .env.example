# ==========================================================================
#  content-console — ตัวอย่างไฟล์ env
#  วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริงในแต่ละบรรทัด
#
#  2026-08-15 — สายผลิตคอนเทนต์ SiamAthlete ถูกถอดออกทั้งชุด
#  env ของ Claude/Gemini/Pollinations/LINE/คลังบทความ/cron จึงถูกลบจากไฟล์นี้ด้วย
#  ถอนค่าเดิมออกจาก Vercel ได้เลย (ดูรายชื่อใน README) — ไม่มีโค้ดอ่านแล้ว
# ==========================================================================

# --- โหมดทำงาน -------------------------------------------------------------
# auto = ตรวจเองว่ามี key ครบไหม (แนะนำ) | mock = บังคับ mock
APP_MODE=auto

# --- แบรนด์ / เว็บไซต์ ------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=SiamAthlete Blog
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.vercel.app
# ลิงก์โซเชียลที่แสดงในหน้าติดต่อ
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/SiamAthlete
NEXT_PUBLIC_LINE_URL=https://line.me

# --- Supabase (ฐานข้อมูล + เก็บรูป) ----------------------------------------
# ใช้โดยหน้าเว็บอ่านบทความเก่า + ฟอร์มติดต่อ
# ที่มา: https://supabase.com → สร้างโปรเจกต์ → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=article-images
# prefix ชื่อตาราง — ตั้งเป็น "sa_" เมื่อแชร์ฐานข้อมูลกับโปรเจกต์อื่น (กันตารางชนกัน)
SUPABASE_TABLE_PREFIX=sa_

# --- Facebook Graph API (เส้น Human of Fit เท่านั้น) ------------------------
# ❗ ต้องเป็นเพจ "Human of Fit" — ไม่ใช่ SiamAthlete และไม่ใช่จงรักผัดไทย
#    verifyPagePost() ผูกกับ FACEBOOK_PAGE_ID ทุกทาง ตั้งผิดเพจ = คอมเมนต์ลงไม่ได้สักใบ
#    ยืนยันด้วย: graph.facebook.com/v21.0/me?fields=id,name&access_token=<PAGE_TOKEN>
#
# สิทธิ์ที่ต้องมี: pages_read_engagement (อ่านโพสต์) + pages_manage_engagement (คอมเมนต์)
#   ❗ ไม่ต้องมี pages_manage_posts แล้ว — ระบบนี้ไม่สร้างโพสต์เอง เจ้าของโพสต์เอง
FACEBOOK_PAGE_ID=YOUR_HUMAN_OF_FIT_PAGE_ID
FACEBOOK_PAGE_ACCESS_TOKEN=YOUR_HUMAN_OF_FIT_PAGE_ACCESS_TOKEN
FACEBOOK_GRAPH_VERSION=v21.0
